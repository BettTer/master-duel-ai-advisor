{
  "name": "master-duel-ai-advisor",
  "version": "0.6.0",
  "description": "Yu-Gi-Oh! Master Duel deckbuilding tools for AI assistants: card lookup, deck import and checks, opening-hand odds and a route planner on EDOPro's rules engine, as an MCP server and a Claude skill",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BettTer/master-duel-ai-advisor.git"
  },
  "homepage": "https://github.com/BettTer/master-duel-ai-advisor#readme",
  "bugs": "https://github.com/BettTer/master-duel-ai-advisor/issues",
  "keywords": [
    "yugioh",
    "yu-gi-oh",
    "master-duel",
    "mcp",
    "mcp-server",
    "claude-skills",
    "deck-builder"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "master-duel-ai-advisor": "dist/mcp.mjs",
    "mdcard": "skills/master-duel-ai-advisor/scripts/mdcard.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm test && npm run typecheck && npm run build",
    "web": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "export:web-data": "node scripts/export-web-data.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@n1xx1/ocgcore-wasm": "npm:@jsr/n1xx1__ocgcore-wasm@^0.1.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zod": "^4.6.7"
  }
}
